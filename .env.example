# --- LSN Jobs / Opportunities ---
# Anthropic key for real LLM enrichment. If unset, enrichment uses the heuristic.
ANTHROPIC_API_KEY="************"
# Enrichment model (default: claude-haiku-4-5 — cheapest capable for extraction).
OPPORTUNITY_ENRICHMENT_MODEL="claude-haiku-4-5"
# Shared secret for the cron endpoint (Bearer token); also used by existing crons.
CRON_SECRET="************"
# Autonomous publishing: when true, cron auto-publishes high-confidence imports.
OPPORTUNITY_AUTOPUBLISH_ENABLED="false"
# Minimum AI confidence (0-100) required to auto-publish without human review.
OPPORTUNITY_AUTOPUBLISH_MIN_CONFIDENCE="80"
# Cost guard: max enrichments per cron run.
OPPORTUNITY_MAX_ENRICH_PER_RUN="50"
# Minimum AI student-relevance (0-100) required to auto-publish.
OPPORTUNITY_AUTOPUBLISH_MIN_RELEVANCE="60"
# Max roles ingested per company per run (breadth over depth).
OPPORTUNITY_INGEST_PER_SOURCE="8"

# --- Adzuna (free aggregator API — cross-sector job ingestion) ---
ADZUNA_APP_ID="************"
ADZUNA_APP_KEY="************"
ADZUNA_WHERE="london"
ADZUNA_MAX_DAYS_OLD="30"
# Cap roles per employer per run (stops recruitment-agency reposts flooding).
ADZUNA_MAX_PER_COMPANY="2"
# Synthetic freshness window (days) — Adzuna roles auto-expire after this.
ADZUNA_FRESHNESS_DAYS="35"
# Source-aware auto-publish gate for aggregator content. Aggregator listings are
# secondhand so the model scores confidence structurally lower (~78 vs ≥80 for
# first-party ATS) — hence a lower confidence bar but a HIGHER relevance bar,
# since relevance is what filters the agency/commission-sales noise.
ADZUNA_AUTOPUBLISH_MIN_CONFIDENCE="72"
ADZUNA_AUTOPUBLISH_MIN_RELEVANCE="70"